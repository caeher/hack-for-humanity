# =============================================================================
# CRI local environment
# Copy this file to .env.local and fill in real values. Never commit secrets.
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Convex
# `npx convex dev` (or `pnpm convex:dev`) writes these two values.
# Do not use https://placeholder.convex.cloud — the app refuses placeholder URLs.
# -----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# -----------------------------------------------------------------------------
# Clerk — Dashboard > API keys
# Publishable keys start with pk_test_ / pk_live_
# Secret keys start with sk_test_ / sk_live_
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# -----------------------------------------------------------------------------
# Clerk JWT issuer for Convex
# 1. Clerk Dashboard > JWT Templates > New template > Convex
#    The template name must be `convex` (matches applicationID in auth.config.ts).
# 2. Copy the Issuer URL (Frontend API URL), e.g. https://verb-noun-00.clerk.accounts.dev
# 3. Put it here AND on the Convex deployment:
#      npx convex env set CLERK_JWT_ISSUER_DOMAIN "https://verb-noun-00.clerk.accounts.dev"
# 4. Re-run `npx convex dev` so auth.config.ts syncs.
# Do not use https://placeholder.clerk.accounts.dev
# -----------------------------------------------------------------------------
CLERK_JWT_ISSUER_DOMAIN=

# -----------------------------------------------------------------------------
# Clerk webhooks (Convex HTTP endpoint)
# 1. Clerk Dashboard > Webhooks > Add endpoint
#    URL: https://<your-deployment>.convex.site/clerk-webhook
# 2. Subscribe to user.* and organization* events
# 3. Copy the Signing Secret (starts with whsec_) and set on Convex:
#      npx convex env set CLERK_WEBHOOK_SECRET "whsec_..."
# -----------------------------------------------------------------------------
CLERK_WEBHOOK_SECRET=
